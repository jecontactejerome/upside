# ─────────────────────────────────────────────────────────────
#  Upside — variables d'environnement
#  Copie ce fichier en .env (jamais commité) et remplis les valeurs.
# ─────────────────────────────────────────────────────────────

# --- Supabase (projet DÉDIÉ à Upside, ≠ On se voix) ---
# Dashboard Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...            # clé publique, utilisée par le front
SUPABASE_SERVICE_KEY=eyJhbGciOi...         # clé service_role — SECRÈTE, ingestion uniquement

# --- Finnhub (note consensus + news) ---
# https://finnhub.io/dashboard  (tier gratuit)
FINNHUB_API_KEY=xxxxxxxxxxxxxxxxxxxx

# --- Google Gemini (brief du jour, tier gratuit) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxx

# --- Divers ---
# Email autorisé à utiliser les favoris (doit matcher la policy RLS watchlist)
ALLOWED_EMAIL=jecontactejerome@gmail.com
